{
  "name": "ai-agents-patterns",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Agent Patterns & Guardrails — a no-build, offline-first vanilla-JS reference app.",
  "scripts": {
    "serve": "python3 serve.py",
    "start": "python3 serve.py",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:data": "node --test test/data.test.mjs",
    "test:e2e": "node test/smoke.mjs",
    "lint": "eslint .",
    "gen": "python3 tools/gen_cascades.py && python3 tools/gen_coverage.py",
    "book": "python3 tools/build_book.py && node tools/render_pdf.mjs",
    "book:rogue": "python3 tools/build_rogue_book.py",
    "book:self": "python3 tools/build_sl_book.py",
    "book:field": "python3 tools/build_field_book.py",
    "book:openshell": "python3 tools/build_openshell_book.py",
    "book:workflows": "python3 tools/build_workflows_book.py",
    "book:qa": "python3 tools/qa_books.py",
    "book:stats": "python3 tools/gen_stats.py --check",
    "check": "npm run lint && npm run test",
    "check:all": "npm run check && npm run test:e2e"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "puppeteer": "^23.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
