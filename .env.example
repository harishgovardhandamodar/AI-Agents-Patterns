# Copy to .env and adjust.  .env is git-ignored and .dockerignore'd.

# Host port the dashboard is published on (LAN + Tailscale).
APP_PORT=5175

# ---------------------------------------------------------------------------
# Local reasoning model (Fox-Architect)
#
# The app never calls the model from the browser; it calls serve.py's
# /api/llm/* proxy, which forwards server-side to these backends in order.
# If none are reachable Fox-Architect falls back to a deterministic local
# analysis, so the app always works.
# ---------------------------------------------------------------------------

# Primary backend — Fox-Services gateway (OpenAI-compatible).
FOX_LLM_URL=http://localhost:8210

# Secondary backend — axiom tailnet node, used when online. Set empty to disable.
AXIOM_LLM_URL=http://100.101.3.115:8210

# Model to request. Fox-Services' managed router may serve an already-loaded
# preferred model instead; the UI reports the model that actually answered.
LLM_MODEL=quai-qwen3.8-27b:latest

# Proxy / client watchdogs (seconds).
#   LLM_READ_TIMEOUT            upstream read ceiling (a cold model may take a while)
#   LLM_FIRST_TOKEN_TIMEOUT     how long the UI waits for the first token
#   LLM_STALL_TIMEOUT           max silence between tokens mid-answer
# A backend can report "online" while the model behind it is wedged; past these
# bounds Fox-Architect stops waiting and answers from the deterministic fallback.
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=600
LLM_FIRST_TOKEN_TIMEOUT=60
LLM_STALL_TIMEOUT=45

# ---------------------------------------------------------------------------
# Only needed for the *dedicated Tailscale node* deployment
# (docker compose -f docker-compose.tailscale.yml up -d --build).
# The default docker-compose.yml rides on the host's existing Tailscale and
# needs none of these.
# ---------------------------------------------------------------------------

# Auth key from https://console.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# Hostname of the node on your tailnet. Becomes the URL:
#   https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=ai-agent-patterns
